# Generated projects should copy this to team/quality-gates.env.
# Empty values are skipped by scripts/run-quality-gates.sh.

RUNTIME_SETUP_CMD=''
INSTALL_CMD='npm install'
LINT_CMD='npm run lint'
TYPECHECK_CMD='npm run typecheck'
REVIEW_CMD=''
UNIT_TEST_CMD='npm test'
INTEGRATION_TEST_CMD='npm run test:integration'
E2E_TEST_CMD='npm run test:e2e'
PERF_SMOKE_CMD='npm run perf'
SECURITY_SMOKE_CMD='npm audit --production'
